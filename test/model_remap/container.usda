#usda 1.0
(
    defaultPrim = "Model1"
    doc = "Test the diff and remapping tools"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def StepTessellationOptions "DefaultOptions"
{
    double step:meshAngularDeflection = 0.1
    double step:meshLinearDeflection = 0.1
}

def StepContainer "Model1" (
    prepend payload = @model1/model1-prototypes.usdc@
)
{
    asset step:sourceAsset = @../step/model1.STEP@

    def StepPrototypes "Prototypes" (
        active = false
    )
    {
        rel step:defaultParams = </DefaultOptions>
    }
}

