#usda 1.0
(
    doc = "A manifold with holes."
    defaultPrim = "Model6"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def CadTessellationOptions "DefaultOptions"
{
    double cad:mesh:angularDeflection = 0.1
    double cad:mesh:linearDeflection = 0.1
}

def CadContainer "Model6" (
    variants = {
        string version = "model4"
    }
    prepend variantSets = "version"
) {
    
    variantSet "version" = {
        "model4" {
            asset cad:sourceAsset = @../model4/model4@
        }
        "model6" {
            asset cad:sourceAsset = @../model6/model6.xbf@
        }
    }

    def CadPrototypes "Prototypes" {
        rel cad:defaultParams = </DefaultOptions>
    }
}

