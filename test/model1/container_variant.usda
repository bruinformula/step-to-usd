#usda 1.0
(
    defaultPrim = "Wonderful"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def StepTessellationOptions "HighOptions"
{
    double step:mesh:angularDeflection = 0.1
    double step:mesh:linearDeflection = 0.1
}

def StepTessellationOptions "LowOptions"
{
    double step:mesh:angularDeflection = 10
    double step:mesh:linearDeflection = 10
}

def StepContainer "Wonderful" (
    variants = {
        string LOD = "high"
    }
    prepend variantSets = "LOD"
)
{
    over "Prototypes" (
        active = false
    )
    {
    }
    variantSet "LOD" = {
        "high" {
            asset step:cacheAsset = @../step/model1.xbf@
            asset step:outputAsset = @model1/high.usdc@
            asset step:sourceAsset = @../step/model1.STEP@

            over StepPrototypes "Prototypes"
            {
                rel step:defaultParams = </HighOptions>

                over "rod_1__78316e9d"
                {
                    double step:mesh:angularDeflection = 0.01
                    double step:mesh:linearDeflection = 0.01
                }
            }

        }
        "low" {
            asset step:cacheAsset = @../step/model2.xbf@
            asset step:outputAsset = @model1/low.usdc@
            asset step:sourceAsset = @../step/model2.STEP@

            over StepPrototypes "Prototypes"
            {
                rel step:defaultParams = </LowOptions>
            }

        }
    }
}

