#usda 1.0
(
    defaultPrim = "Wonderful"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def CadTessellationOptions "DefaultOptions"
{
    int cad:meshMaxNumberRemeshPasses = 1
}

def CadTessellationOptions "FinalOptions"
{
    double cad:mesh:angularDeflection = 0.05
    double cad:mesh:linearDeflection = 0.05
}

def CadTessellationOptions "HighOptions"
{
    double cad:mesh:angularDeflection = 0.1
    double cad:mesh:linearDeflection = 0.1
}

def CadTessellationOptions "LowOptions"
{
    double cad:mesh:angularDeflection = 10
    double cad:mesh:linearDeflection = 10
}

def "World"
{
    def CadContainer "Wonderful" (
        variants = {
            string LOD = "high"
        }
        prepend variantSets = "LOD"
    )
    {
        asset cad:sourceAsset = @../step/model1.xbf@

        over "Prototypes"
        {
            over "rod_1__78316e9d" (
                variants = {
                    string quality = "default"
                }
                variantSets = "quality"
            )
            {
                variantSet "quality" = {
                    "default" (
                        references = </DefaultOptions>
                    ) {

                    }
                    "draft" (
                        references = </LowOptions>
                    ) {

                    }
                    "final" (
                        references = </FinalOptions>
                    ) {

                    }
                }
            }
        }
        variantSet "LOD" = {
            "high" {
                asset cad:outputAsset = @model1/high.usdc@

                over CadPrototypes "Prototypes"
                {
                    rel cad:defaultParams = </HighOptions>

                    over "rod_1__78316e9d"
                    {
                        double cad:mesh:angularDeflection = 0.01
                        double cad:mesh:linearDeflection = 0.01
                    }
                }

            }
            "low" {
                asset cad:outputAsset = @model1/low.usdc@

                over CadPrototypes "Prototypes"
                {
                    rel cad:defaultParams = </LowOptions>
                }

            }
        }
    }
}

