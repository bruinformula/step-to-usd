#usda 1.0
(
    defaultPrim = "Model1"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def CadTessellationOptions "OptionsA"
{
    double cad:mesh:angularDeflection = 15
    double cad:mesh:linearDeflection = 0.1
}

def CadTessellationOptions "OptionsB"
{
    double cad:mesh:angularDeflection = 0.1
    double cad:mesh:linearDeflection = 0.1
}

def CadContainer "Model1" {
    asset cad:sourceAsset = @../assemblies/model1.xbf@
    asset cad:outputAsset = @model1/test.usdc@

    over CadPrototypes "Prototypes" (
        active = false
    )
    {
        rel cad:defaultParams = </OptionsA>

        over "rod_1__78316e9d" (
            variants = {
                string quality = "final"
            }
            variantSets = "quality"
        )
        {
            variantSet "quality" = {
                "draft" (
                    references = </OptionsA>
                ) {

                }
                "final" (
                    references = </OptionsB>
                ) {

                }
            }
        }
    }
}

