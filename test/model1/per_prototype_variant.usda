#usda 1.0
(
    defaultPrim = "Model1"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def StepTessellationOptions "OptionsA"
{
    double step:mesh:angularDeflection = 15
    double step:mesh:linearDeflection = 0.1
}

def StepTessellationOptions "OptionsB"
{
    double step:mesh:angularDeflection = 0.1
    double step:mesh:linearDeflection = 0.1
}

def StepContainer "Model1" {
    asset step:sourceAsset = @../step/model1.STEP@

    over StepPrototypes "Prototypes" (
        active = false
    )
    {
        rel step:defaultParams = </OptionsA>

        over "rod_1__78316e9d" (
            variants = {
                string quality = "final"
            }
            variantSets = "quality"
        )
        {
            variantSet "quality" = {
                "draft" (
                    references = </OptionsA>
                ) {

                }
                "final" (
                    references = </OptionsB>
                ) {

                }
            }
        }
    }
}

