#usda 1.0
(
    defaultPrim = "Wonderful"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def StepTessellationOptions "DefaultOptions"
{
    int step:maxNumberRemeshPasses = 5
}

def StepTessellationOptions "HighOptions"
{
    float step:meshAngularDeflection = 0.1
    float step:meshLinearDeflection = 0.1
}

def StepTessellationOptions "LowOptions"
{
    float step:meshAngularDeflection = 10
    float step:meshLinearDeflection = 10
}

def StepFileContainer "Wonderful" (
    variants = {
        string LOD = "high"
        string model = "v1"
    }
    prepend variantSets = ["LOD", "model"]
)
{
    over "Prototypes" (
        active = false
    )
    {
    }
    variantSet "model" = {
        "v1" (
            prepend payload = @model1/model/model1-model-v1-prototypes.usda@
        ) {
            asset step:sourceAsset = @step/model1.STEP@

            over "Prototypes"
            {
            }

        }
        "v2" (
            prepend payload = @model1/model/model1-model-v2-prototypes.usda@
        ) {
            asset step:sourceAsset = @step/model2.STEP@

            over "Prototypes"
            {
            }

        }
    }
    variantSet "LOD" = {
        "high" (
            prepend payload = @model1/LOD/model1-LOD-high-prototypes.usda@
        ) {
            over StepFileContainer "Prototypes"
            {
                rel step:defaultParams = </HighOptions>
            }

        }
        "low" (
            prepend payload = @model1/LOD/model1-LOD-low-prototypes.usda@
        ) {
            over StepFileContainer "Prototypes"
            {
                rel step:defaultParams = </LowOptions>
            }

        }
    }
}

