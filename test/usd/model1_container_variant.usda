#usda 1.0
(
    defaultPrim = "Wonderful"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def StepTessellationOptions "HighOptions"
{
    double step:meshAngularDeflection = 0.1
    double step:meshLinearDeflection = 0.1
}

def StepTessellationOptions "LowOptions"
{
    double step:meshAngularDeflection = 10
    double step:meshLinearDeflection = 10
}

def StepFileContainer "Wonderful" (
    variants = {
        string LOD = "low"
    }
    prepend variantSets = "LOD"
)
{
    asset step:sourceAsset = @step/model1.STEP@

    over "Prototypes" (
        active = false
    )
    {
    }
    variantSet "LOD" = {
        "high" (
            prepend payload = @model1/LOD/model1-LOD-high-prototypes.usdc@
        ) {
            over StepFilePrototypes "Prototypes"
            {
                rel step:defaultParams = </HighOptions>

                over "rod_1__78316e9d"
                {
                    double step:meshAngularDeflection = 0.01
                    double step:meshLinearDeflection = 0.01
                }
            }

        }
        "low" (
            prepend payload = @model1/LOD/model1-LOD-low-prototypes.usdc@
        ) {
            over StepFilePrototypes "Prototypes"
            {
                rel step:defaultParams = </LowOptions>
            }

        }
    }
}

