#usda 1.0
(
    defaultPrim = "Wonderful"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def StepTessellationOptions "DefaultOptions"
{
    double step:meshAngularDeflection = 0.075
    double step:meshLinearDeflection = 0.075

    double step:sketchPlaneLinearDeflection = 1.0
    double step:sketchPlaneAngularDeflection = 0.5
    double step:sketchPlaneMinSize = 0.01
    double step:sketchPlaneCombineTolerance = 1e-7
}

def StepFileContainer "Wonderful" (
    prepend payload = @model3/model3-prototypes.usdc@
)
{
    asset step:sourceAsset = @step/model3.STEP@

    def StepFilePrototypes "Prototypes" (
        active = false
    )
    {
        rel step:defaultParams = </DefaultOptions>
    }

    over "CADPart"
    {
        over "Wireframe" (
            active = false
        )
        {
        }
    }
}

