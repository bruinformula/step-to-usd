#usda 1.0
(
    defaultPrim = "Wonderful"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def StepTessellationOptions "OptionsA"
{
    double step:meshAngularDeflection = 15
    double step:meshLinearDeflection = 0.1
}

def StepTessellationOptions "OptionsB"
{
    double step:meshAngularDeflection = 0.1
    double step:meshLinearDeflection = 0.1
}

def StepFileContainer "Wonderful" (
    prepend payload = [
        @model1/model1-prototypes.usdc@
    ]
)
{
    asset step:sourceAsset = @step/model1.STEP@

    over StepFilePrototypes "Prototypes" (
        active = false
    )
    {
        rel step:defaultParams = </OptionsA>

        over "rod_1__78316e9d" (
            variants = {
                string quality = "final"
            }
            variantSets = "quality"
        )
        {
            variantSet "quality" = {
                "draft" (
                    references = </OptionsA>
                ) {

                }
                "final" (
                    references = </OptionsB>
                ) {

                }
            }
        }
    }
}

