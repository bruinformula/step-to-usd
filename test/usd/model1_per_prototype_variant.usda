#usda 1.0
(
    defaultPrim = "Wonderful"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def StepTessellationOptions "OptionsA"
{
    float step:meshAngularDeflection = 15
    float step:meshLinearDeflection = 0.1
}

def StepTessellationOptions "OptionsB"
{
    float step:meshAngularDeflection = 0.1
    float step:meshLinearDeflection = 0.1
}

def StepFileContainer "Wonderful" (
    prepend payload = @model1-assembly.usda@
)
{
    asset step:sourceAsset = @step/model1.STEP@

    over StepFilePrototypes "Prototypes" (
        active = false
    )
    {
        rel step:defaultParams = </OptionsA>

        over "rod0" (
            variants = {
                string quality = "final"
            }
            variantSets = "quality"
        )
        {
            variantSet "quality" = {
                "draft" (
                    references = </OptionsA>
                ) {

                }
                "final" (
                    references = </OptionsB>
                ) {

                }
            }
        }
    }
}

