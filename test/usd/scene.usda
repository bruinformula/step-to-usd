#usda 1.0
(
    subLayers = [
        @sphere.usda@
    ]
)

over "SphereMesh" (
    prepend apiSchemas = ["MaterialBindingAPI"]
) {
    rel material:binding = </MaterialX/Materials/Wonderful>
}


def Scope "MaterialX" (
	references = [
		@test_wonderful.mtlx@</MaterialX>,
	]
) {}

def DistantLight "KeyLight"
{
    float intensity = 500.0
    color3f color = (1.0, 1.0, 1.0)
    float angle = 0.53

    double3 xformOp:translate = (5, 5, 5)
    double3 xformOp:rotateXYZ = (-45, 45, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}
