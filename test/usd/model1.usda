#usda 1.0
(
    defaultPrim = "Wonderful"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def StepTessellationOptions "DefaultOptions"
{
    float step:meshAngularDeflection = 15
    float step:meshLinearDeflection = 0.1
    bool step:wireframeCombineCurves = 0
}

def StepFileContainer "Wonderful" (
    prepend payload = @model1/model1-prototypes.usda@
)
{
    asset step:sourceAsset = @step/model1.STEP@

    def StepFilePrototypes "Prototypes" (
        active = false
    )
    {
        rel step:defaultParams = </DefaultOptions>

        over "rod0"
        {
            float step:meshAngularDeflection = 0.1
            float step:meshLinearDeflection = 0.01
        }

        over "bolt0"
        {
            float step:meshAngularDeflection = 0.5
            float step:meshLinearDeflection = 0.1
        }
    }

    over "CADPart"
    {
        over "Wireframe" (
            active = false
        )
        {
        }
    }
}

