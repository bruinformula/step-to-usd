#usda 1.0
(
    defaultPrim = "Wonderful"
    metersPerUnit = 0.001
    subLayers = [
        @model1-assembly.usdc@
    ]
    upAxis = "Z"
)

def StepTessellationOptions "DefaultOptions"
{
    int step:maxNumberRemeshPasses = 5
}

def StepTessellationOptions "FinalOptions"
{
    float step:meshAngularDeflection = 0.05
    float step:meshLinearDeflection = 0.05
}

def StepTessellationOptions "HighOptions"
{
    float step:meshAngularDeflection = 0.1
    float step:meshLinearDeflection = 0.1
}

def StepTessellationOptions "LowOptions"
{
    float step:meshAngularDeflection = 10
    float step:meshLinearDeflection = 10
}

def StepFileContainer "Wonderful"
{
    asset step:sourceAsset = @step/model1.STEP@

    over "Prototypes" (
        active = false
        variants = {
            string LOD = "high"
        }
        prepend variantSets = "LOD"
    )
    {
        over "rod0" (
            variants = {
                string quality = "default"
            }
            variantSets = "quality"
        )
        {
            variantSet "quality" = {
                "default" (
                    references = </DefaultOptions>
                ) {

                }
                "draft" (
                    references = </LowOptions>
                ) {

                }
                "final" (
                    references = </FinalOptions>
                ) {

                }
            }
        }
        variantSet "LOD" = {
            "high" (
                prepend payload = @LOD/model1-LOD-high-prototypes.usdc@</Prototypes>
            ) {
                rel step:defaultParams = </HighOptions>

            }
            "low" (
                prepend payload = @LOD/model1-LOD-low-prototypes.usdc@</Prototypes>
            ) {
                rel step:defaultParams = </LowOptions>

            }
        }
    }
}

