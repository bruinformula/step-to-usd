#usda 1.0
(
    defaultPrim = "Model2"
    doc = "Corner MacPherson strut suspension assembly"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def StepTessellationOptions "DefaultOptions"
{
    bool step:wireframeCombineCurves = 1
    double step:meshAngularDeflection = 0.1
    double step:meshLinearDeflection = 0.1
}

def StepContainer "Model2" (
    prepend payload = [
        @model2/model2-sandwich.usda@
    ]
)
{
    asset step:sourceAsset = @../step/model2.STEP@

    def StepPrototypes "Prototypes" {
        rel step:defaultParams = </DefaultOptions>
    }
}
