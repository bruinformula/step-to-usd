#usda 1.0
(
    defaultPrim = "Model3"
    doc = "An enclosure of some kind. Contains sketches."
    metersPerUnit = 0.001
    upAxis = "Z"
)

def StepTessellationOptions "DefaultOptions"
{
    double step:meshAngularDeflection = 0.1
    double step:meshLinearDeflection = 0.1
    bool step:wireframeEmbedSurfaceNormals = 1 
    token step:wireframeSampling = "underlying"
}

def StepContainer "Model3" (
    prepend payload = @model3/model3-prototypes.usdc@
)
{
    asset step:sourceAsset = @../step/model3.STEP@

    def StepPrototypes "Prototypes" (
        active = false
    )
    {
        rel step:defaultParams = </DefaultOptions>
    }
}

