#usda 1.0
(
    defaultPrim = "Model3"
    doc = "An enclosure of some kind. Contains sketches."
    metersPerUnit = 0.001
    upAxis = "Z"
)

def CadTessellationOptions "DefaultOptions"
{
    double cad:mesh:angularDeflection = 0.1
    double cad:mesh:linearDeflection = 0.1
    bool cad:wireframe:embedSurfaceNormals = 1
    bool cad:sketch:combineCurves = false
    token cad:wireframe:sampling = "underlying"
    
}

def CadContainer "Model3" {
    asset cad:sourceAsset = @../assemblies/model3.xbf@
    asset cad:outputAsset = @model3/geom.usdc@

    def CadPrototypes "Prototypes" {
        rel cad:defaultParams = </DefaultOptions>
    }
}

