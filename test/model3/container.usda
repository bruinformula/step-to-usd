#usda 1.0
(
    defaultPrim = "Model3"
    doc = "An enclosure of some kind. Contains sketches."
    metersPerUnit = 0.001
    upAxis = "Z"
)

def StepTessellationOptions "DefaultOptions"
{
    double step:mesh:angularDeflection = 0.1
    double step:mesh:linearDeflection = 0.1
    bool step:wireframe:embedSurfaceNormals = 1
    bool step:sketch:combineCurves = false
    token step:wireframe:sampling = "underlying"
    
}

def StepContainer "Model3" {
    asset step:cacheAsset = @../step/model3.xbf@
    asset step:sourceAsset = @../step/model3.STEP@
    asset step:outputAsset = @model3/geom.usdc@

    def StepPrototypes "Prototypes" {
        rel step:defaultParams = </DefaultOptions>
    }
}

