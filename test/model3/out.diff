+template <typename T>
+void readAttribute(const UsdPrim& prim,
+                   const TfToken& name,
+                   T& destination)
+{
+    const UsdAttribute attr = prim.GetAttribute(name);
+
+    if (!attr)
+        return;
+
+    T value{};
+    if (attr.Get(&value))
+        destination = value;
+}
+
+template <auto Member>
+struct ParamField {
+    TfToken attribute;
+};
+
+template <auto Member>
+ParamField<Member> field(TfToken attribute) {
+    return {std::move(attribute)};
+}
+
+template <typename Params, auto Member>
+void readField(
+    const UsdPrim& prim,
+    Params& params,
+    const ParamField<Member>& field)
+{
+    const UsdAttribute attr = prim.GetAttribute(field.attribute);
+    if (!attr)
+        return;
+
+    auto& destination = params.*Member;
+
+    // Preserve the default if conversion fails.
+    auto value = destination;
+    if (readUsdValue(attr, value))
+        destination = std::move(value);
+}
+
+template <typename Params, typename Fields>
+Params readParams(
+    const UsdPrim& prim,
+    const Fields& fields)
+{
+    Params params{};
+
+    std::apply([&](const auto&... f) {
+            (readField(prim, params, f), ...);
+    }, fields);
+
+    return params;
+}
+
+
 } // namespace CadUSD
