#usda 1.0
(
    subLayers = [
        @usd/schema.usda@,
        @usdGeom/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "stepellation"
        string libraryPath = "."
        string libraryPrefix = "Autolib"
    }
) {}

class "StepFileContainerAPI" (
    inherits = </APISchemaBase>
    doc = "Container for STEP file metadata and tessellation options. Should be applied to a prim at or above the scope of any STEP geometry. The presence of this schema on a prim signals that it is a STEP file root and should be exported as such."
    customData = {
        token apiSchemaType = "singleApply"
    }
) {
    asset step:sourceAsset (
        doc = "Path to the source STEP file. This is for informational purposes only and is not automatically resolved or loaded by the exporter."
        customData = { string variability = "SdfVariabilityUniform" }
    )
}

class "StepTessellationAPI" (
    inherits = </APISchemaBase>
    doc = "Step tessellation quality parameters. Child prims will take on the opinions of the nearest parent prim"
    customData = {
        token apiSchemaType = "singleApply"
    }
) {
    rel step:tessellationOptions (
        doc = "Relationship to a StepTessellationOptions prim whose values override the local attrs"
    )

    float step:meshLinearDeflection = 1.0 (
        doc = "Linear deflection as a fraction of the bounding-box diagonal. Maps to --meshLinearDeflection."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    float step:meshAngularDeflection = 0.5 (
        doc = "Angular deflection in radians. Maps to --meshAngularDeflection."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    double step:meshMinSize = 0.0 (
        doc = "Minimum triangle edge length as a fraction of the bounding-box diagonal. Maps to --meshMinSize."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    token step:wireframeType = "linear" (
        doc = "Curve type used for wireframe edges. Maps to --wireframeType."
        allowedTokens = ["none", "linear", "catmullRom"]
        customData = { string variability = "SdfVariabilityUniform" }
    )
    token step:wireframeSampling = "underlying" (
        doc = "Sampling strategy for wireframe edge curves. Maps to --wireframeSampling."
        allowedTokens = ["underlying", "resampled"]
        customData = { string variability = "SdfVariabilityUniform" }
    )
    float step:wireframeDeflection = 0.01 (
        doc = "Deflection tolerance for wireframe edge curve sampling. Maps to --wireframeDeflection."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    token step:sketchType = "none" (
        doc = "Curve type used for sketch and free-edge curves. Maps to --sketchType."
        allowedTokens = ["none", "linear", "catmullRom"]
        customData = { string variability = "SdfVariabilityUniform" }
    )
    token step:sketchSampling = "underlying" (
        doc = "Sampling strategy for sketch and free-edge curves. Maps to --sketchSampling."
        allowedTokens = ["underlying", "resampled"]
        customData = { string variability = "SdfVariabilityUniform" }
    )
    float step:sketchDeflection = 0.005 (
        doc = "Deflection tolerance for sketch/free-edge curve sampling. Maps to --sketchDeflection."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    float step:renderPurposeThreshold = 0.0 (
        doc = "Parts with a render-purpose weight below this threshold are suppressed. 0 disables the filter. Maps to --renderPurposeThreshold."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    double step:selfIntersectionThreshold = 1e-3 (
        doc = "Threshold for detecting self-intersecting triangles during meshing. Maps to --selfIntersectionThreshold."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    int step:maxNumberRemeshPasses = 3 (
        doc = "Maximum number of remeshing passes to attempt if self-intersections are detected. Maps to --maxNumberRemeshPasses."
        customData = { string variability = "SdfVariabilityUniform" }
    )
}

class "StepTessellationOptions" (
    inherits = </Typed>
    typeName = "StepTessellationOptions"
    doc = "Concrete prim class that carries a complete authored set of StepTessellationAPI values."
    prepend apiSchemas = ["StepTessellationAPI"]
    customData = {
        token schemaKind = "concreteTyped"
    }
) {
    float step:meshLinearDeflection = 1.0
    float step:meshAngularDeflection = 0.5
    double step:meshMinSize = 0.0
    token step:wireframeType = "linear"
    token step:wireframeSampling = "underlying"
    float step:wireframeDeflection = 0.01
    token step:sketchType = "none"
    token step:sketchSampling = "underlying"
    float step:sketchDeflection = 0.005
    float step:renderPurposeThreshold = 0.0
    double step:selfIntersectionThreshold = 1e-3
    int step:maxNumberRemeshPasses = 3
}

class "StepFileContainer" (
    inherits = </Xform>
    typeName = "StepFileContainer"
    doc = """Concrete Xform prim that identifies a STEP file root. 
             It inherits all default tessellation settings and provides 
             the target asset path."""
    prepend apiSchemas = ["StepFileContainerAPI", "StepTessellationAPI"]
    customData = {
        token schemaKind = "concreteTyped"
    }
) {
    asset step:sourceAsset = @@ 
}