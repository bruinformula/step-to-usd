#usda 1.0
(
    subLayers = [
        @usd/schema.usda@,
        @usdGeom/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "stepTessellation"
        string libraryPath = "."
        string libraryPrefix = "Autolib"
    }
) {}

class "StepFileContainerAPI" (
    inherits = </APISchemaBase>
    doc = "Container for STEP file. The presence of this schema on a prim signals that it is a STEP file root and should be exported as such."
    customData = {
        token apiSchemaType = "singleApply"
    }
) {
    asset step:sourceAsset (
        doc = "Path to the source STEP file. This is for informational purposes only and is not automatically resolved or loaded by the exporter."
        customData = { string variability = "SdfVariabilityUniform" }
    )
}

class "StepFilePrototypesAPI" (
    inherits = </APISchemaBase>
    doc = "Container for StepFileContainer Prototypes metadata and tessellation options. "
    customData = {
        token apiSchemaType = "singleApply"
    }
) {
    rel step:defaultParams (
        doc = "Relationship to a prim that carries the default tessellation parameters for this STEP file. This is intended to point to a StepTessellationOptions prim. If not specified, defaults will be used."
        customData = { string variability = "SdfVariabilityUniform" }
    )
}

class "StepTessellationAPI" (
    inherits = </APISchemaBase>
    doc = "Step tessellation quality parameters. Child prims will take on the opinions of the nearest parent prim"
    customData = {
        token apiSchemaType = "singleApply"
    }
) {
    int step:defIndex = 0 ( 
        doc = "Unique index of the prototype. Used for debugging" 
        customData = { string variability = "SdfVariabilityUniform" } 
    )

    # Meshing
    double step:meshFixPrecision = 1e-7 (
        doc = "Tolerance for shape fixing operations. Expressed as a fraction of the bounding-box diagonal."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    double step:meshFixTolerance = 1e-7 (
        doc = "Tolerance for meshing operations. Expressed as a fraction of the bounding-box diagonal."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    double step:meshLinearDeflection = 1.0 (
        doc = "Linear deflection as a fraction of the bounding-box diagonal."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    double step:meshAngularDeflection = 0.5 (
        doc = "Angular deflection in radians."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    double step:meshMinSize = 0.0 (
        doc = "Minimum triangle edge length as a fraction of the bounding-box diagonal."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    double step:meshSelfIntersectionThreshold = 1e-3 (
        doc = "Threshold for detecting self-intersecting triangles during meshing."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    int step:meshMaxNumberRemeshPasses = 1 (
        doc = "Maximum number of remeshing passes to attempt if self-intersections are detected."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    uint64 step:meshFixTimeout = 3000 (
        doc = "Timeout in milliseconds for the shape fixing pass."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    uint64 step:meshMeshTimeout = 3000 (
        doc = "Timeout in milliseconds for the initial meshing pass."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    uint64 step:meshRemeshTimeout = 3000 (
        doc = "Timeout in milliseconds for each remeshing pass when self-intersections are detected."
        customData = { string variability = "SdfVariabilityUniform" }
    )

    # Wireframe
    token step:wireframeType = "linear" (
        doc = "Curve type used for wireframe edges."
        allowedTokens = ["none", "linear", "cubic"]
        customData = { string variability = "SdfVariabilityUniform" }
    )
    token step:wireframeSampling = "underlying" (
        doc = "Sampling strategy for wireframe edge curves."
        allowedTokens = ["underlying", "resampled"]
        customData = { string variability = "SdfVariabilityUniform" }
    )
    double step:wireframeDeflection = 10 (
        doc = "Deflection tolerance for wireframe edge curve sampling."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    bool step:wireframeCombineCurves = 1 (
        doc = "Whether to export every TopoDS_Edge as a separate curve prim, or to combine them into one curve."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    bool step:wireframeEmbedSurfaceNormals = 1 (
        doc = "Whether to embed the surface normals of the underlying mesh as primvars on wireframe curve prims."
        customData = { string variability = "SdfVariabilityUniform" }
    )

    # Sketch
    token step:sketchType = "linear" (
        doc = "Curve type used for sketch and free-edge curves."
        allowedTokens = ["none", "linear", "cubic"]
        customData = { string variability = "SdfVariabilityUniform" }
    )
    token step:sketchSampling = "underlying" (
        doc = "Sampling strategy for sketch and free-edge curves."
        allowedTokens = ["underlying", "resampled"]
        customData = { string variability = "SdfVariabilityUniform" }
    )
    double step:sketchDeflection = 10 (
        doc = "Deflection tolerance for sketch/free-edge curve sampling."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    bool step:sketchCombineCurves = 1 (
        doc = "Whether to export every TopoDS_Edge as a separate curve prim, or to combine them into one curve."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    bool step:sketchEmbedSurfaceNormals = 1 (
        doc = "Whether to embed the surface normals of the underlying sketch as primvars on sketch curve prims."
        customData = { string variability = "SdfVariabilityUniform" }
    )

    # Meshing
    double step:sketchPlaneLinearDeflection = 1.0 (
        doc = "Linear deflection as a fraction of the bounding-box diagonal."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    double step:sketchPlaneAngularDeflection = 0.5 (
        doc = "Angular deflection in radians."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    double step:sketchPlaneMinSize = 0.0 (
        doc = "Minimum triangle edge length as a fraction of the bounding-box diagonal."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    double step:sketchPlaneCombineTolerance = 1e-5 (
        doc = "Tolerance for combining coplanar faces into a single plane during meshing. Expressed as a fraction of the bounding-box diagonal."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    uint64 step:sketchPlaneFixTimeout = 3000 (
        doc = "Timeout in milliseconds for the shape fixing pass."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    uint64 step:sketchPlaneTimeout = 3000 (
        doc = "Timeout in milliseconds for the initial meshing pass."
        customData = { string variability = "SdfVariabilityUniform" }
    )

    # Other
    double step:renderPurposeThreshold = 0.0 (
        doc = "Parts with a render-purpose weight below this threshold are suppressed. 0 disables the filter."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    bool step:meshEnableSurfaceSubsets = 0 (
        doc = "Whether to create USD subsets for each unique surface ID in the STEP file. This can be handy for material binding."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    bool step:meshEnableUVs = 1 (
        doc = "Whether to export UVs when available. Disabling this can speed up exports when UVs are not needed."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    bool step:meshEnableSurfaceID = 0 (
        doc = "Whether to export the TopoDS_Face surface ID as a primvar."
        customData = { string variability = "SdfVariabilityUniform" }
    )
    bool step:meshEnableIsBoundaryVertex = 0 (
        doc = "Whether to export marked vertices that are on the boundary of TopoDS_Faces (i.e. the wireframe) as a primvar."
        customData = { string variability = "SdfVariabilityUniform" }
    )  
}

# Concrete Types

class "StepFileContainer" (
    inherits = </Xform>
    typeName = "StepFileContainer"
    doc = """Concrete prim that identifies a STEP file root. Provides 
             the target asset path."""
    prepend apiSchemas = ["StepFileContainerAPI"]
    customData = {
        token schemaKind = "concreteTyped"
    }
) {
    asset step:sourceAsset = @@ 
}

class "StepFilePrototypes" (
    inherits = </Scope>
    typeName = "StepFilePrototypes"
    doc = """Concrete Scope prim that indicates a StepFileContainer's Prototypes"""
    prepend apiSchemas = ["StepFilePrototypesAPI"]
    customData = {
        token schemaKind = "concreteTyped"
    }
) {
    
}

class "StepTessellationOptions" (
    inherits = </Typed>
    typeName = "StepTessellationOptions"
    doc = "Concrete prim class that carries a complete authored set of StepTessellationAPI values."
    prepend apiSchemas = ["StepTessellationAPI"]
    customData = {
        token schemaKind = "concreteTyped"
    }
) {
    # Meshing 
    double step:meshLinearDeflection = 1.0
    double step:meshAngularDeflection = 0.5
    double step:meshMinSize = 0.0
    double step:meshSelfIntersectionThreshold = 1e-3
    int step:meshMaxNumberRemeshPasses = 1
    uint64 step:meshFixTimeout = 3000
    uint64 step:meshMeshTimeout = 3000
    uint64 step:meshRemeshTimeout = 3000
    # Wireframe
    token step:wireframeType = "linear"
    token step:wireframeSampling = "underlying"
    double step:wireframeDeflection = 10
    bool step:wireframeCombineCurves = 1
    # Sketch
    token step:sketchType = "linear"
    token step:sketchSampling = "underlying"
    double step:sketchDeflection = 10
    bool step:sketchCombineCurves = 1
    # Sketch Planes
    double step:sketchPlaneLinearDeflection = 1.0
    double step:sketchPlaneAngularDeflection = 0.5
    double step:sketchPlaneMinSize = 0.0
    double step:sketchPlaneCombineTolerance = 1e-5
    uint64 step:sketchPlaneFixTimeout = 3000
    uint64 step:sketchPlaneMeshTimeout = 3000
    # Other
    double step:renderPurposeThreshold = 0.0
    bool step:meshEnableSurfaceSubsets = 0
    bool step:meshEnableUVs = 1
    bool step:meshEnableSurfaceID = 0
    bool step:meshEnableIsBoundaryVertex = 0
}